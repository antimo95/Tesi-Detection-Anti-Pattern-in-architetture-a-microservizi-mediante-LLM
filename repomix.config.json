{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 52428800
  },
  "output": {
    "filePath": "repo_scan.txt",
    "style": "plain",
    "parsableStyle": false,
    "fileSummary": false,
    "directoryStructure": true,
    "files": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "compress": false,
    "topFilesLength": 5,
    "showLineNumbers": true,
    "truncateBase64": false,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": false,
    "tokenCountTree": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.pdf",
      "**/*.ipynb",
      "**/*.jar",
      "**/*.exe",
      "**/*.dll",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "**/*.7z",
      "**/*.class",
      "**/*.o",
      "**/*.so",
      "**/*.dylib",
      "**/*.bin",
      "**/*.npy",
      "**/*.pickle",
      "**/*.pb",
      "**/*.index",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.woff",
      "**/*.woff2",
      "**/*.ttf",
      "**/*.eot",
      "**/*.otf",
      "**/.idea/**",
      "**/.vscode/**",
      "**/*.iml",
      "**/.DS_Store",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.cache/**",
      //"**/.gradle/**",
      //"**/.mvn/**",
      "node_modules/**/*",
      "build/**/*",
      "dist/**/*",
      "**/target/**",
      "**/out/**",
      "**/bin/**",
      "**/static/lib/**",
      "**/static/vendor/**",
      "**/vendor/**",
      "**/bower_components/**",
      "**/src/main/resources/static/**/bootstrap/**",
      "**/microsec-test/**",
      "tests/**/*",
      "**/tests/**",
      "**/test/**",
      "**/testing/**",
      "**/__tests__/**",
      "**/src/test/**",
      "**/src/**/test/**",
      "**/*-test/**",
      "**/*_test/**",
      "**/test-*/**",
      "**/tests-*/**",
      "**/*.log",
      "**/*.patch",
      "**/*.bak",
      "**/*.swp",
      "**/*.tmp",
      "**/coverage/**",
      "**/.nyc_output/**",
      "**/surefire-reports/**",
      "**/failsafe-reports/**",
      "**/*.md",
      "**/*.adoc",
      "**/*.rst",
      "**/*/cnn/**/*",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/*.spec.ts",
      "**/*.test.ts",
      "**/*.spec.js",
      "**/*.test.js",
      "**/*Test.java",
      "**/*Tests.java",
      "**/*IT.java"
    ]
  },
  "security": {
    "enableSecurityCheck": false
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}